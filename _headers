# Einstellungen für Cloudflare Pages / Netlify

# Die beiden Cross-Origin-Zeilen erlauben Stockfish mehrere Prozessorkerne (F20).
# Folge: Bilder/Skripte von fremden Seiten gehen nur, wenn diese es erlauben (Turnstile, Supabase, Lichess, ChessDB getestet).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Bibliotheken ändern sich nur mit neuer Version
/vendor/*
  Cache-Control: public, max-age=604800

# Der Service Worker muss immer frisch geladen werden
/sw.js
  Cache-Control: no-cache
